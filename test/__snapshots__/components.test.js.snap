// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`FeedbackDialogElement markup matches the snapshot 1`] = `
"<!--
  role="alertdialog" marks it as an interruption that needs acknowledgement;
  the icon is decorative because the title and message carry the outcome.
-->
<dialog class="inchi-dialog feedback-dialog" role="alertdialog" aria-labelledby="feedbackTitle" aria-describedby="feedbackMessage">
  <div class="inchi-dialog-body">
    <div class="feedback-icon">
      <i class="feedback-glyph" aria-hidden="true"></i>
    </div>

    <h2 id="feedbackTitle"></h2>
    <p id="feedbackMessage"></p>

    <button type="button" class="btn btn-primary feedback-confirm">OK</button>
  </div>
</dialog>
"
`;

exports[`InChIResultFieldElement markup matches the snapshot 1`] = `
"<div class="identifier-plate notation-frame">
      <div class="identifier-head">
        <span class="apparatus">InChIKey</span>
        <span class="d-flex align-items-center gap-2">
          <span class="version-stamp" data-version-stamp="" hidden=""></span>
          <span class="btn-group" role="group">
            <button type="button" class="btn btn-sm btn-outline-secondary result-copy" aria-label="Copy InChIKey to clipboard" disabled="">
              <svg class="app-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 2.5H10V4.5H6ZM3.5 4.5H12.5V14H3.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"></path></svg>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary result-download" aria-label="Download InChIKey as a text file" disabled="">
              <svg class="app-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2.5V10.2M5 7.4 8 10.5 11 7.4M3 12V14H13V12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"></path></svg>
            </button>
          </span>
        </span>
      </div>
      <div class="identifier-view" aria-live="polite" aria-atomic="false" hidden=""></div>
      <pre id="workbench-inchikey" class="py-1 px-3 mb-0 inchi-result-text" style="max-height: 500px" hidden=""></pre>
    </div>"
`;

exports[`InChIVersionSelectionElement markup matches the snapshot 1`] = `
"<div class="bounding-box">
      <h2 class="inchi-section-heading" id="version-heading">
        InChI version
      </h2>
      <label class="visually-hidden" for="version-dropdown">InChI version</label>
      <select id="version-dropdown" class="form-select form-select-sm mt-1" data-version=""><optgroup label="Released"><option value="1.06">1.06</option></optgroup><optgroup label="Development builds"><option value="Dev">Dev</option></optgroup><optgroup label="Open pull requests"><option value="Dev PR 42">Dev PR 42</option></optgroup><optgroup label="Other builds"><option value="Local">Local</option></optgroup></select>
      <p class="version-commit apparatus mt-2 mb-0">Released · <a href="https://github.com/IUPAC-InChI/InChI/releases/tag/v1.06" target="_blank" rel="noopener">1.06 release notes</a></p>
    </div>"
`;

exports[`InChIWorkbenchElement markup matches the snapshot 1`] = `
{
  "markup": "<!--
  The editor is the single source of truth for what is converted; the paste
  field and the file picker fill it. The output column reads
  containsReaction() and shows the InChI block or the RInChI block.
-->
<div class="tool-workbench">
  <div class="tool-input">
    <div class="ratio ketcher">
      <iframe id="workbench-ketcher" title="Structure and reaction editor" class="w-100" src="ketcher/index.html" onload="onKetcherLoaded('workbench-ketcher', () => onEditorChanged())"></iframe>
    </div>
    <!--
      Shown only when a paste is being converted verbatim and the editor is
      only drawing it.
    -->
    <p class="editor-role apparatus" data-editor-role="" hidden=""></p>
    <!--
      Pasted text is converted verbatim: this is a reference tool, so an InChI
      it reports has to be the one the library gives for that exact file. The
      editor draws the paste as a preview; editing the drawing hands the
      source back to it.
    -->
    <details class="bounding-box mt-2" data-paste-panel="">
      <summary>
        <h2 class="inchi-section-heading">Paste a structure</h2>
      </summary>
      <label class="visually-hidden" for="workbench-paste">
        Molfile, SD file text, AuxInfo, reaction file, RInChI, SMILES or
        PubChem identifier
      </label>
      <div class="paste-shell mt-1">
        <textarea id="workbench-paste" class="form-control paste-field" autocomplete="off" spellcheck="false" rows="6" aria-describedby="workbench-paste-hint" placeholder="Paste or drop a molfile, SD file text, an AuxInfo string, an RXN or RD file, a RInChI (with its RAuxInfo on a second line), a SMILES or CXSMILES, or a PubChem identifier such as SID 24866042 or CID 2244" ondragover="onTextareaDragover(event)" ondrop="onTextareaDrop(event, () => loadPastedInput())" oninput="
            syncPasteControls();
            loadPastedInputDebounced();
          "></textarea>
        <!--
          Clears the canvas too, so the two halves of the input cannot be left
          disagreeing.
        -->
        <button type="button" class="paste-clear" data-paste-clear="" onclick="clearPasteField()" aria-label="Clear the paste field and the drawing" title="Clear the paste field and the drawing" disabled="">
          <svg class="app-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M2.5 4.5h11M6.5 4.5V2.5h3v2M4 4.5l.8 9h6.4l.8-9M6.5 7v4M9.5 7v4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
          </svg>
        </button>
      </div>
      <!--
        Shown after an edit to the drawing. The text stays; emptying the canvas
        clears it (see onEditorChanged).
      -->
      <p class="paste-state" data-paste-state="" hidden="">
        <span class="apparatus">Not being converted — the drawing is</span>
        <button type="button" class="link-button" onclick="loadPastedInput()">
          Convert this text again
        </button>
      </p>
      <small id="workbench-paste-hint" class="text-muted">
        What you paste is converted exactly as given — the editor above only
        draws it, so nothing is rewritten on the way to the library. Edit the
        drawing and it becomes the source instead. An AuxInfo has to contain
        atom coordinates, or there is nothing to draw. Two inputs are the
        exception to converting what you gave. A PubChem identifier: the
        record is fetched from PubChem over the network and that is what gets
        converted, so the prefix is required — SID and CID number
        different things. And a SMILES: it carries no coordinates, so the
        editor lays the structure out and the molfile it produces is what gets
        converted — which means the stereo the library sees was drawn by
        the editor, not by you. A CXSMILES carrying its own coordinates keeps
        them.
      </small>
    </details>

    <div class="bounding-box mt-2">
      <h2 class="inchi-section-heading" id="workbench-sdf-heading">SD file</h2>
      <label class="visually-hidden" for="workbench-sdf">SD file</label>
      <input id="workbench-sdf" type="file" class="form-control mt-1" accept=".sdf" aria-describedby="workbench-sdf-hint" onchange="loadSdFile()">
      <small id="workbench-sdf-hint" class="text-muted">
        One InChI and InChIKey per record. Choosing a record draws it in the
        editor and fills the output fields.
      </small>
    </div>
  </div>

  <!--
    InChI only: the RInChI build is fixed and takes no options, so the panel
    goes with the InChI block when the editor holds a reaction (showOutput).
  -->
  <div class="tool-controls tool-controls-bottom" data-output="inchi">
    <inchi-version-selection onversionchange="onChangeInchiVersion()"></inchi-version-selection>
    <div data-inchi-options=""></div>
  </div>

  <div class="tool-output">
    <!--
      The announcer is never hidden, because a hidden node is out of the
      accessibility tree.
    -->
    <div class="visually-hidden" data-status-announcer="" role="status" aria-live="polite"></div>
    <div class="conversion-status" data-status="" hidden=""></div>

    <!--
      Selecting an SD file record draws it in the editor; the plates below
      then describe that record.
    -->
    <div data-sdf-records="" hidden=""></div>
    <!--
      The whole file as text: one InChI, AuxInfo and InChIKey per record, in
      file order. The plate's copy and download buttons are the export.
    -->
    <inchi-result-field id="workbench-sdf-export-wrapper" title="All records" placeholder="Every record's InChI, AuxInfo and InChIKey, once an SD file is chosen." hidden=""></inchi-result-field>

    <!--
      Hidden when the editor holds a reaction; the fields keep their content,
      so switching back does not re-run a conversion.
    -->
    <div data-output="inchi">
      <inchi-result-field id="workbench-inchi-wrapper" title="InChI" placeholder="The InChI appears here as you draw, split into its layers." notation="inchi" live=""></inchi-result-field>
      <inchi-result-field id="workbench-inchikey-wrapper" title="InChIKey" placeholder="The hashed key, derived from the InChI above." notation="inchikey"></inchi-result-field>

      <div class="comparison-controls">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-pin="" disabled="" onclick="pinCurrentResult()">
          Pin this result to compare
        </button>
        <button type="button" class="link-button comparison-clear" data-clear-comparison="" disabled="" onclick="clearComparison()">
          Clear comparison
        </button>
      </div>
      <div data-comparison="" hidden=""></div>

      <div class="bounding-box mt-3">
        <inchi-ngl-viewer id="workbench-ngl-viewer"></inchi-ngl-viewer>
      </div>

      <details class="secondary-plates" open="">
        <summary>Auxiliary information and library log</summary>
        <inchi-result-field id="workbench-auxinfo-wrapper" title="AuxInfo" placeholder="Auxiliary information: atom numbering and coordinates."></inchi-result-field>
        <inchi-result-field id="workbench-logs-wrapper" title="Log" placeholder="Messages from the InChI library, when it has any."></inchi-result-field>
      </details>
    </div>

    <!--
      RInChI has no layer grammar (inchi-layers.js parses InChI only), so
      these render as plain text.
    -->
    <div data-output="rinchi" hidden="">
      <!--
        RXN format has no equilibrium notation, so a pasted reaction can only
        be declared an equilibrium here. Initialised from the drawn arrow on
        every conversion; overrides it when the visitor sets it.
      -->
      <div class="bounding-box">
        <div class="form-check">
          <input id="workbench-forceequilibrium" class="form-check-input" type="checkbox" onchange="updateWorkbench()">
          <label class="form-check-label" for="workbench-forceequilibrium">
            Treat this reaction as an equilibrium
          </label>
        </div>
        <p class="rinchi-version apparatus mb-0">Computed with RInChI version test-version</p>
      </div>
      <inchi-result-field id="workbench-rinchi-wrapper" title="RInChI" placeholder="Draw a reaction arrow and the RInChI appears here." live=""></inchi-result-field>
      <inchi-result-field id="workbench-longrinchikey-wrapper" title="Long-RInChIKey" placeholder="The long key, derived from the RInChI above."></inchi-result-field>
      <inchi-result-field id="workbench-shortrinchikey-wrapper" title="Short-RInChIKey" placeholder="The short key, derived from the RInChI above."></inchi-result-field>
      <inchi-result-field id="workbench-webrinchikey-wrapper" title="Web-RInChIKey" placeholder="The web key, derived from the RInChI above."></inchi-result-field>
      <div class="bounding-box mt-3">
        <h2 class="inchi-section-heading">Reaction file</h2>
        <div class="row-cols-auto mt-1" role="group" aria-label="File format">
          <div class="form-check">
            <input id="reaction-format-rxn" class="form-check-input" type="radio" name="reactionFileFormat" value="RXN" checked="">
            <label class="form-check-label" for="reaction-format-rxn">RXN</label>
          </div>
          <div class="form-check">
            <input id="reaction-format-rd" class="form-check-input" type="radio" name="reactionFileFormat" value="RD">
            <label class="form-check-label" for="reaction-format-rd">RD</label>
          </div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-generate-reaction-file="" onclick="downloadReactionFile()">
          Generate file text
        </button>
        <inchi-result-field id="workbench-reaction-file-wrapper" title="Reaction file" placeholder="The RXN or RD file text for the RInChI above."></inchi-result-field>
        <inchi-result-field id="workbench-reaction-file-logs-wrapper" title="Log" placeholder="Messages from the RInChI library, when it has any."></inchi-result-field>
      </div>
      <details class="secondary-plates" open="">
        <summary>Auxiliary information and library log</summary>
        <inchi-result-field id="workbench-rauxinfo-wrapper" title="RAuxInfo" placeholder="Auxiliary information for the reaction's structures."></inchi-result-field>
        <inchi-result-field id="workbench-rinchi-logs-wrapper" title="Log" placeholder="Messages from the RInChI library, when it has any."></inchi-result-field>
      </details>
    </div>

    <report-mask></report-mask>
  </div>
</div>

<feedback-dialog id="feedbackDialog"></feedback-dialog>
",
  "rinchiVersion": [
    "Computed with RInChI version test-version",
  ],
}
`;

exports[`NGLViewerElement markup matches the snapshot 1`] = `
"<div class="ngl-viewer-header mt-3">
        <h3 class="inchi-section-heading">Atom annotations</h3>
        <button type="button" class="btn btn-sm btn-outline-secondary ngl-fullscreen-button" title="Toggle full screen" aria-label="Toggle full screen">
          <svg class="app-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 6V2.5H6M2.5 2.5 6 6M10 2.5H13.5V6M13.5 2.5 10 6M13.5 10V13.5H10M13.5 13.5 10 10M6 13.5H2.5V10M2.5 13.5 6 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"></path></svg>
        </button>
      </div>
      <fieldset class="annotation-selection mt-1">
        <legend class="visually-hidden">Atom annotations to overlay</legend>
      <button type="button" data-annotation="index" class="annotation-index annotation-button" disabled="" aria-pressed="false"><span class="annotation-swatch"></span>Index</button><button type="button" data-annotation="canonicalIndex" class="annotation-canonical-index annotation-button" disabled="" aria-pressed="false"><span class="annotation-swatch"></span>Canonical Index</button><button type="button" data-annotation="equivalenceClass" class="annotation-equivalence-class annotation-button" disabled="" aria-pressed="false"><span class="annotation-swatch"></span>Equivalence Class</button><button type="button" data-annotation="hydrogenGroup" class="annotation-hydrogen-group annotation-button" disabled="" aria-pressed="false"><span class="annotation-swatch"></span>Hydrogen Group</button><button type="button" data-annotation="hydrogenGroupClass" class="annotation-hydrogen-group-class annotation-button" disabled="" aria-pressed="false"><span class="annotation-swatch"></span>Hydrogen Group Class</button></fieldset>
      <details class="mt-1">
        <summary class="apparatus">What these mean</summary>
        <dl class="annotation-legend mt-1 mb-0 small"><dt class="apparatus">Index</dt><dd class="mb-2">Order of atoms in the molfile's atom block.</dd><dt class="apparatus">Canonical Index</dt><dd class="mb-2">Indices assigned by the canonicalization.</dd><dt class="apparatus">Equivalence Class</dt><dd class="mb-2">Atoms within an equivalence class are indistinguishable, ignoring stereochemistry; a class is identified by the smallest canonical index in the class.</dd><dt class="apparatus">Hydrogen Group</dt><dd class="mb-2">If there are multiple components, groups start at 1 for each component.</dd><dt class="apparatus">Hydrogen Group Class</dt><dd class="mb-2">If there are multiple components, group-classes start at 1 for each component.</dd></dl>
      </details>
      <div class="ngl-viewport mt-2"></div>"
`;

exports[`ReportMaskElement markup matches the snapshot 1`] = `
"<button type="button" class="btn btn-sm btn-outline-secondary mask-open mt-3">
  Report a problem or send feedback
</button>

<!--
  A native <dialog> supplies the modal behaviour: focus trap, Escape to close,
  an inert page behind it and focus returned to the trigger on close.

  Two routes, because they go to different people: a wrong InChI is sent
  privately to the InChI Trust with the structure, and anything about the web
  app itself becomes a public GitHub issue the visitor opens in their own
  account. Each route is a fieldset; the one not chosen is disabled, which
  also takes its required fields out of the form's validation.
-->
<dialog class="inchi-dialog mask-dialog" aria-labelledby="maskTitle">
  <div class="inchi-dialog-body">
    <header>
      <h2 id="maskTitle">Report a problem or send feedback</h2>
      <button type="button" class="mask-close" aria-label="Close dialog">
        <svg class="app-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M3.5 3.5 12.5 12.5M12.5 3.5 3.5 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
        </svg>
      </button>
    </header>

    <form>
      <fieldset class="mask-routes">
        <legend class="mask-label">What is it about?</legend>
        <label class="mask-route">
          <input type="radio" name="maskRoute" value="inchi" checked="">
          <span>
            <span class="mask-route-name">A wrong or unexpected InChI</span>
            <span class="mask-route-hint">Sent privately to the InChI Trust, with your structure.</span>
          </span>
        </label>
        <label class="mask-route">
          <input type="radio" name="maskRoute" value="app">
          <span>
            <span class="mask-route-name">This web app: a bug, a question or an idea</span>
            <span class="mask-route-hint">Opens a public GitHub issue. Needs a GitHub account.</span>
          </span>
        </label>
      </fieldset>

      <fieldset class="mask-route-fields" data-mask-route="inchi">
        <p class="mask-intro">
          This is the only place where your structure leaves your browser.
          Every conversion — InChI, InChIKey, RInChI, AuxInfo — runs locally
          and is never uploaded.
        </p>
        <p class="mask-intro">
          Your structure and description, along with the generated InChI,
          InChIKey, log, and selected options are sent to the
          Beilstein-Institut for the InChI Trust.
        </p>

        <label class="mask-label" for="nameInput">Your name or email
          <span class="mask-optional">(optional)</span></label>
        <input type="text" id="nameInput" class="mask-name" maxlength="200" autocomplete="name" placeholder="So we can follow up with you">

        <label class="mask-label" for="descriptionInput">What is wrong with this structure?</label>
        <textarea rows="5" id="descriptionInput" class="mask-description" maxlength="4000" placeholder="e.g. the stereo descriptor is missing for the double bond" required=""></textarea>

        <div class="disclaimer-section">
          <label for="disclaimerCheckbox" class="disclaimer-label">
            <input type="checkbox" id="disclaimerCheckbox" class="disclaimer-checkbox" required="">
            <span>I acknowledge that this report will be submitted for review and
              may be publicly shared to improve the InChI library.</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="mask-route-fields" data-mask-route="app" disabled="" hidden="">
        <label class="mask-label" for="issueCategory">Kind</label>
        <select id="issueCategory" class="form-select mask-issue-category">
          <option value="bug">Bug</option>
          <option value="suggestion">Suggestion</option>
          <option value="question">Question</option>
        </select>

        <label class="mask-label" for="issueMessage">Your message</label>
        <textarea rows="5" id="issueMessage" class="mask-issue-message" maxlength="2000" placeholder="What happened, or what would help?" required=""></textarea>

        <label class="mask-attach">
          <input type="checkbox" class="mask-issue-identifier" checked="">
          <span>Include the current InChI</span>
        </label>

        <p class="mask-label mb-1">What gets attached</p>
        <pre class="mask-issue-preview" data-mask-issue-preview=""></pre>

        <p class="mask-intro mask-public-note">
          The issue is <strong>public</strong>: anyone can read it. Nothing is
          sent until you submit it on GitHub.
        </p>
      </fieldset>

      <div class="mask-actions">
        <button type="button" class="btn btn-outline-secondary mask-cancel">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary mask-submit">
          Send report
        </button>
      </div>
    </form>
  </div>
</dialog>
"
`;
